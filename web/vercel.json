{
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "git": {
    "deploymentEnabled": {
      "datos": false
    }
  },
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}